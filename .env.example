# Docker Compose project and shared network
COMPOSE_PROJECT_NAME=local-infrastructure
LOCAL_INFRA_NETWORK=local-infrastructure-network

# Stable RabbitMQ node identity. Preserve the old hostname when reusing its data.
RABBITMQ_HOSTNAME=rabbitmq

# Published localhost ports
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MONGODB_PORT=27017
MONGO_EXPRESS_PORT=8081
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PORTAINER_HTTP_PORT=9002
PORTAINER_HTTPS_PORT=9443
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379

# Non-sensitive local usernames
RABBITMQ_USERNAME=local
MONGODB_USERNAME=local
MONGO_EXPRESS_USERNAME=local-admin
MINIO_ROOT_USER=local-admin
MYSQL_DATABASE=local
MYSQL_USERNAME=local
POSTGRES_DATABASE=local
POSTGRES_USERNAME=local

# Passwords are generated and appended by setup-local.sh.
# Do not add working credentials, tokens, or private URLs to this file.
